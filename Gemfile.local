# frozen_string_literal: true

source "https://rubygems.org"

# Development manifest (auto-evaluated by the local bundler plugin). Uses the
# local robot_lab checkout; the release Gemfile pins the published gem instead.
gemspec

# Cross-gem development: local robot_lab checkout.
gem "robot_lab", path: "../robot_lab"

gem "flay"
gem "flog"
gem "irb"
gem "rake", "~> 13.0"

gem "minitest", "~> 5.16"
gem "minitest-reporters"
gem "rack-test"
gem "rubocop"
