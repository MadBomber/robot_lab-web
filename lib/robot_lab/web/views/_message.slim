/ One transcript message. Rendered server-side for the non-streaming fallback;
/ the SSE client builds the same markup in JS (see chat.slim).
div class="msg #{event.role}"
  .role
    = event.role
    - if event.robot_name
      |  · #{event.robot_name}
  - case event.role
  - when :tool_call
    = "#{event.tool_name}(#{event.content[:args].to_json})"
  - when :tool_result
    - if event.content[:error]
      = "#{event.tool_name} → error: #{event.content[:error]}"
    - else
      = "#{event.tool_name} → #{event.content[:result]}"
  - when :error
    = event.error_message
  - else
    = event.text
