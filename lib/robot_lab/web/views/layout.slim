doctype html
html lang="en"
  head
    meta charset="utf-8"
    meta name="viewport" content="width=device-width, initial-scale=1"
    meta name="csrf-token" content=csrf_token
    title robot_lab-web
    css:
      :root { color-scheme: dark; }
      * { box-sizing: border-box; }
      body { margin: 0; background: #0e0f13; color: #e6e6e6;
             font: 15px/1.5 ui-sans-serif, system-ui, -apple-system, sans-serif; }
      a { color: #7aa2f7; text-decoration: none; }
      header { padding: 14px 20px; border-bottom: 1px solid #23262e;
               display: flex; align-items: center; gap: 12px; }
      header .gem { color: #bb9af7; font-weight: 700; letter-spacing: .04em; }
      main { max-width: 880px; margin: 0 auto; padding: 24px 20px 64px; }
      h1, h2 { font-weight: 650; }
      .robots, .activity { list-style: none; padding: 0; }
      .robots li { padding: 10px 14px; border: 1px solid #23262e; border-radius: 8px;
                   margin-bottom: 8px; background: #14161c; }
      .activity li { padding: 6px 0; border-bottom: 1px solid #1b1e25; font-size: 13px; color: #9aa0aa; }
      .transcript { display: flex; flex-direction: column; gap: 10px;
                    min-height: 240px; padding: 8px 0 16px; }
      .msg { padding: 10px 14px; border-radius: 10px; max-width: 92%; white-space: pre-wrap;
             word-break: break-word; border: 1px solid #23262e; }
      .msg.user { align-self: flex-end; background: #1f2a44; border-color: #2c3b63; }
      .msg.robot { align-self: flex-start; background: #15211a; border-color: #234a36; }
      .msg.tool_call, .msg.tool_result { align-self: flex-start; background: #14161c;
             color: #c0c6d0; font-size: 13px; font-family: ui-monospace, monospace; }
      .msg.error { align-self: flex-start; background: #2a1518; border-color: #5b2730; color: #ffb4bd; }
      .msg .role { font-size: 11px; text-transform: uppercase; letter-spacing: .06em;
                   color: #6b7280; margin-bottom: 4px; }
      form.composer { display: flex; gap: 8px; position: sticky; bottom: 0;
                      background: #0e0f13; padding: 12px 0; }
      input[type=text] { flex: 1; padding: 11px 14px; border-radius: 9px;
                         border: 1px solid #2a2e38; background: #14161c; color: #e6e6e6; }
      button { padding: 11px 18px; border-radius: 9px; border: 0; cursor: pointer;
               background: #7aa2f7; color: #0b0d12; font-weight: 650; }
      button[disabled] { opacity: .5; cursor: default; }
  body
    header
      span.gem ◆ robot_lab-web
      a href="/" Dashboard
    main
      == yield
